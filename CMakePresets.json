{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conf-mingw-default",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "UDS_LINE_BUILD_TESTS": "ON",
                "UDS_LINE_BUILD_DOCS": "ON"
            }
        },
        {
            "name": "conf-gcc-default",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "UDS_LINE_BUILD_TESTS": "ON",
                "UDS_LINE_BUILD_DOCS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-test-targets",
            "hidden": true,
            "targets": [
                "test_UdsLine_Properties"
            ]
        },
        {
            "name": "build-cov-targets",
            "hidden": true,
            "targets": [
                "coverage_report"
            ]
        },
        {
            "name": "build-docs-targets",
            "hidden": true,
            "targets": [
                "Sphinx"
            ]
        },
        {
            "name": "build-tests-gcc",
            "configurePreset": "conf-gcc-default",
            "inherits": "build-test-targets"
        },
        {
            "name": "build-cov-gcc",
            "configurePreset": "conf-gcc-default",
            "inherits": "build-cov-targets"
        },
        {
            "name": "build-docs-gcc",
            "configurePreset": "conf-gcc-default",
            "inherits": "build-docs-targets"
        }
    ],
    "testPresets": [
        {
            "name": "test-all-gcc",
            "configurePreset": "conf-gcc-default",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "workflow-build",
            "steps": [
                {
                    "type": "configure",
                    "name": "conf-gcc-default"
                },
                {
                    "type": "build",
                    "name": "build-tests-gcc"
                }
            ]
        },
        {
            "name": "workflow-test",
            "steps": [
                {
                    "type": "configure",
                    "name": "conf-gcc-default"
                },
                {
                    "type": "build",
                    "name": "build-tests-gcc"
                },
                {
                    "type": "test",
                    "name": "test-all-gcc"
                },
                {
                    "type": "build",
                    "name": "build-cov-gcc"
                }
            ]
        },
        {
            "name": "workflow-docs",
            "steps": [
                {
                    "type": "configure",
                    "name": "conf-gcc-default"
                },
                {
                    "type": "build",
                    "name": "build-docs-gcc"
                }
            ]
        }
    ]
}
